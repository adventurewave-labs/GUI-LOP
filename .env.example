# ==========================================
# GUI-LOP Environment Variables
# Copy this file to .env and update with your values
# ==========================================

# Application Configuration
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://gui-lop:your-secure-postgres-password-here@postgres:5432/gui_lop
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gui_lop
DB_USER=gui-lop
DB_PASSWORD=your-secure-postgres-password-here

# Redis Configuration (Week 5-6 Phase 2 - Caching Layer)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CLUSTER_NODES=redis:6379

# Redis Connection Settings
REDIS_MAX_CONNECTIONS=10
REDIS_MIN_CONNECTIONS=2
REDIS_CONNECTION_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_MAX_RETRIES=3

# Redis Memory Settings
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_MEMORY_LIMIT=256mb

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-min-256-bits
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-min-256-bits
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WebSocket Configuration
WS_PORT=3002

# UI Generation Configuration
UI_GENERATION_TIMEOUT=30000
STREAMLIT_PORT_RANGE=8501-8600
GRADIO_PORT_RANGE=7860-7900

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_ROUNDS=12
ENABLE_SECURITY_HEADERS=true

# Cache Configuration (Redis)
ENABLE_REDIS_CACHING=true
CACHE_DEFAULT_TTL=3600
CACHE_FALLBACK_ENABLED=true
CACHE_MONITORING_ENABLED=true
CACHE_WARMING_ENABLED=true
CACHE_HEALTH_CHECK_INTERVAL=30000

# Workflow Cache Settings
WORKFLOW_TEMPLATE_CACHE_TTL=7200
USER_SESSION_CACHE_TTL=1800
API_RESPONSE_CACHE_TTL=600
USER_DATA_CACHE_TTL=900
WORKFLOW_DATA_CACHE_TTL=3600

# Session Configuration
SESSION_MAX_PER_USER=5
SESSION_ROTATION_INTERVAL=900000
IP_VALIDATION_ENABLED=true
SUSPICIOUS_ACTIVITY_DETECTION=true

# Cache Warming Configuration
CACHE_WARMING_STARTUP_DELAY=5000
CACHE_WARMING_SCHEDULED_INTERVAL=300000
CACHE_WARMING_PREDICTIVE_ENABLED=true

# Cache Monitoring Configuration
CACHE_MONITORING_ENABLED=true
CACHE_MONITORING_INTERVAL=60000
CACHE_ALERT_MEMORY_THRESHOLD=80
CACHE_ALERT_HIT_RATE_THRESHOLD=50
CACHE_ALERT_RESPONSE_TIME_THRESHOLD=100

# Cache Health Configuration
CACHE_HEALTH_CHECK_ENABLED=true
CACHE_HEALTH_CHECK_INTERVAL=30000
CACHE_FALLBACK_IN_MEMORY_SIZE=1000
CACHE_FALLBACK_IN_MEMORY_TTL=300000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/gui-lop.log

# Development Configuration
ENABLE_CORS=true
ENABLE_RATE_LIMITING=false

# Feature Flags
ENABLE_SESSION_CACHING=true
ENABLE_WORKFLOW_CACHING=true
ENABLE_API_RESPONSE_CACHING=true
ENABLE_CACHE_INVALIDATION=true
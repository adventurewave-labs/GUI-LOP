# =============================================================================
# GUI-LOP environment configuration template.
#
# Copy to `.env` and fill in real values. Never commit `.env` itself
# (ADR 0022 — secrets management). The schema below mirrors
# `src/backend/shared-kernel/config/config-loader.js` exactly.
#
# Legend:
#   [required]  must be set or bootstrap fails fast
#   [optional]  has a default; uncomment to override
# =============================================================================

# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------

# [optional] one of: development | test | production
NODE_ENV=production

# [optional] HTTP port the bootstrap server binds to.
PORT=3001

# [required, secret] HMAC secret for signing JWT access + refresh tokens.
# Generate with: openssl rand -base64 64
# In production, mount via the platform secrets manager — never bake into images.
JWT_SECRET=change-me-to-a-256-bit-random-string

# [optional] Access-token lifetime in seconds (default 900 = 15 min).
JWT_ACCESS_TTL_SECONDS=900

# [optional] Refresh-token lifetime in seconds (default 604800 = 7 days).
JWT_REFRESH_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# Persistence (optional — bootstrap uses in-memory adapters when blank)
# -----------------------------------------------------------------------------

# [optional] Postgres URL. Leave blank for in-memory persistence in dev.
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://gui_lop:gui_lop@postgres:5432/gui_lop
# Pool + session safety (see src/backend/shared-kernel/infrastructure/pg-pool.js).
# Keep replicas x DB_POOL_MAX under the server's max_connections.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_S=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=30000
DB_APPLICATION_NAME=gui-lop-api

# [optional] Redis URL. Leave blank to fall back to in-process pub/sub.
# Format: redis://[:password@]host:6379/0
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Auth & rate limiting
# -----------------------------------------------------------------------------

# [optional] bcrypt cost factor. Production default is 12; the worker-thread
# pool keeps the event loop free even at this cost (ADR 0021). Tests use 4.
BCRYPT_WORK_FACTOR=12
# NIST SP 800-63B rev. 4: 15 while the password is the only factor (no MFA yet); floor 8.
PASSWORD_MIN_LENGTH=15

# [optional] General /api/v1 rate-limit window (ms). Redis-backed when REDIS_URL is set. Default 60000.
RATE_LIMIT_WINDOW_MS=60000

# [optional] Max /api/v1 requests per window per client IP. Default 600 (10 req/s). Auth routes have stricter built-in limits.
RATE_LIMIT_MAX=600

# -----------------------------------------------------------------------------
# Outbox / event bus
# -----------------------------------------------------------------------------

# [optional] Rows fetched per outbox consumer tick. 200 is the bench-tuned
# sweet spot — see config-loader.js for the rationale.
OUTBOX_BATCH_SIZE=200

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# [optional] Log level: debug | info | warn | error. JSON to stdout (ADR 0021).
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------

# [optional] Comma-separated list of allowed origins for the CORS layer.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# AI provider (UI generation context, ADR 0023)
# -----------------------------------------------------------------------------

# [optional] stub | openai | anthropic. `stub` needs no key and makes no calls.
AI_PROVIDER=stub
# [required when AI_PROVIDER != stub] Vendor API key. Never commit a real one.
AI_API_KEY=
# [optional] Gateway / proxy base URL override.
AI_BASE_URL=
# [optional] Model id (anthropic default claude-haiku-4-5, openai default gpt-4o-mini).
AI_MODEL=
# [optional] Separate (cheaper/faster) model for classification. Defaults to AI_MODEL.
AI_MODEL_CLASSIFY=
# [optional] Per-call timeout and retry budget.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# HTTP server hardening
# -----------------------------------------------------------------------------

# [optional] Express `trust proxy`: false | true | hop count | CSV of subnets.
# Set to 1 behind a single LB/ingress so req.ip is the real client.
TRUST_PROXY=false

# [optional] Slowloris / LB alignment. Keep-alive must exceed the LB idle
# timeout (ALB default 60s).
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEPALIVE_TIMEOUT_MS=65000

# [optional, DEV ONLY] Accept unauthenticated X-User-Id on WebSocket upgrades.
# Refused at boot when NODE_ENV=production. Clients should send the access
# token via ?token=, Authorization: Bearer, or Sec-WebSocket-Protocol: bearer,<token>.
WS_ALLOW_HEADER_AUTH=false

# [optional] WebSocket limits. Upgrades are only accepted on /ws/v1 and, for
# browsers, only from CORS_ORIGINS. Frames over the payload cap close with 1009.
WS_MAX_CONNECTIONS_PER_USER=10
WS_MAX_PAYLOAD_BYTES=65536

# [optional] Prometheus metrics at GET /metrics. With METRICS_TOKEN set,
# scrapers must send Authorization: Bearer <token>. Without it the endpoint is
# open in dev and returns 404 when NODE_ENV=production.
METRICS_ENABLED=true
METRICS_TOKEN=

# [optional] Graceful shutdown. On SIGTERM: /readyz → 503 and keep serving for
# the drain delay, then close WS (1001), finish in-flight requests, release
# pools. Keep SHUTDOWN_TIMEOUT_MS below the orchestrator's kill grace period.
SHUTDOWN_DRAIN_DELAY_MS=5000
SHUTDOWN_TIMEOUT_MS=25000

# -----------------------------------------------------------------------------
# Compose-only convenience values (read by docker-compose.yml only — the
# bootstrap config loader does NOT consume these).
# -----------------------------------------------------------------------------

POSTGRES_DB=gui_lop
POSTGRES_USER=gui_lop
POSTGRES_PASSWORD=gui_lop
POSTGRES_PORT=5432
REDIS_PORT=6379

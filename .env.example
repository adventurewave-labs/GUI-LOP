# GUI-LOP Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://localhost:5432/gui-lop
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gui-lop
DB_USER=postgres
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# WebSocket Configuration
WS_PORT=3002

# UI Generation Configuration
UI_GENERATION_TIMEOUT=30000
STREAMLIT_PORT_RANGE=8501-8600
GRADIO_PORT_RANGE=7860-7900

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/gui-lop.log

# Development Configuration
ENABLE_CORS=true
ENABLE_RATE_LIMITING=false
{
  "name": "gui-lop",
  "version": "1.0.0",
  "description": "The Generative UI & Human-in-the-Loop Orchestration Platform (GUI-LOP)",
  "main": "src/backend/simple-server.js",
  "scripts": {
    "start": "node src/backend/simple-server.js",
    "dev": "nodemon src/backend/simple-server.js",
    "start:frontend": "concurrently \"npm run dev\" \"cd src/frontend && npm start\"",
    "dev:full": "concurrently \"npm run dev\" \"cd src/frontend && npm start\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "gui",
    "hitl",
    "orchestration",
    "react"
  ],
  "author": "GUI-LOP Development Team",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  }
}

{
  "name": "gui-lop",
  "version": "1.0.0",
  "description": "The Generative UI & Human-in-the-Loop Orchestration Platform (GUI-LOP)",
  "main": "src/backend/simple-server.js",
  "scripts": {
    "start": "node src/backend/simple-server.js",
    "dev": "nodemon src/backend/simple-server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:performance": "node tests/performance/run-tests.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "build": "tsc",
    "lint": "eslint src tests --ext .js,.ts,.jsx,.tsx",
    "typecheck": "tsc --noEmit",
    "playwright": "playwright test",
    "playwright:report": "playwright show-report",
    "playwright:install": "playwright install",
    "setup:db": "psql -f config/database.sql",
    "start:frontend": "concurrently \"npm run dev\" \"cd src/frontend && npm start\"",
    "dev:full": "concurrently \"npm run dev\" \"cd src/frontend && npm start\""
  },
  "keywords": [
    "gui",
    "hitl",
    "orchestration",
    "langgraph",
    "playwright",
    "testing",
    "react",
    "streamlit",
    "gradio"
  ],
  "author": "GUI-LOP Development Team",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@langchain/langgraph": "^0.4.9",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "langchain": "^0.3.35",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "axios": "^1.7.9",
    "benchmark": "^2.1.4",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "playwright": "^1.55.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,ts,jsx,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/helpers/setup.ts"
    ],
    "testTimeout": 10000,
    "extensionsToTreatAsEsm": [
      ".ts",
      ".js"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "globals": {
      "ts-jest": {
        "useESM": true
      }
    }
  }
}

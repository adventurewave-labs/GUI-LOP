# GUI-LOP Monitoring System Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# Elasticsearch Configuration
# =============================================================================
ELASTICSEARCH_PASSWORD=changeme_elastic_password
KIBANA_PASSWORD=changeme_kibana_password

# =============================================================================
# Grafana Configuration
# =============================================================================
GRAFANA_PASSWORD=changeme_grafana_password

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_PASSWORD=changeme_postgres_password
REDIS_PASSWORD=changeme_redis_password

# =============================================================================
# Notification Configuration
# =============================================================================

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@example.com

# PagerDuty Integration
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key

# Twilio SMS (if using SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# Security Configuration
# =============================================================================
SECURITY_ENCRYPTION_KEY=your_32_byte_encryption_key_here

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=production
CLUSTER_NAME=gui-lop
DATACENTER=primary

# =============================================================================
# External Integrations (Optional)
# =============================================================================

# Jira Integration
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your_username
JIRA_TOKEN=your_api_token
JIRA_PROJECT=INC

# ServiceNow Integration
SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password
SERVICENOW_ASSIGNMENT_GROUP=Security

# StatusPage Integration
STATUSPAGE_API_KEY=your_statuspage_api_key
STATUSPAGE_PAGE_ID=your_statuspage_id

# AWS Integration (if using AWS services)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Azure Monitor Integration (if using Azure)
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id

# Datadog Integration (if using Datadog)
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APPLICATION_KEY=your_datadog_application_key

# =============================================================================
# Advanced Configuration
# =============================================================================

# OpenTelemetry Configuration
OTLP_ENDPOINT=http://localhost:4317

# Custom Headers for External Services
CUSTOM_HEADER_NAME=X-API-Key
CUSTOM_HEADER_VALUE=your_api_key

# Backup Configuration
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key

# =============================================================================
# Development Configuration (Only for development environment)
# =============================================================================
# NODE_ENV=development
# DEBUG=monitoring:*
# LOG_LEVEL=debug